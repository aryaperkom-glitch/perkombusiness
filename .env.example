# ===== Local PostgreSQL (Docker) =====
POSTGRES_DB=officeless
POSTGRES_USER=officeless
POSTGRES_PASSWORD=change-me

# Used by the app when running on the host (npm run dev).
# Inside Docker Compose the app container gets db:5432 injected automatically.
# Avoid special characters (@, :, /) in POSTGRES_PASSWORD or URL-encode them here.
DATABASE_URL=postgresql://officeless:change-me@localhost:5432/officeless

# ===== Session auth =====
# Signs the login session cookie. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ===== Service Desk / EnvGate =====
SERVICEDESK_USERNAME=
SERVICEDESK_PASSWORD=

# ===== Kirimi WhatsApp gateway =====
KIRIMI_USER_CODE=
KIRIMI_SECRET=
KIRIMI_DEVICE_ID=

# ===== Ops scripts (optional — see docs/operations.md) =====
# RETENTION_DAYS=14
# DEPLOY_BRANCH=main
# BACKUP_REMOTE=user@backup-host:/srv/backups/officeless/

# ===== One-off Supabase migration (remove after migrating) =====
# NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# Then run: node --env-file=.env scripts/import-supabase-users.mjs
#           node --env-file=.env scripts/import-supabase-files.mjs
